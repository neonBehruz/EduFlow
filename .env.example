# EduFlow SaaS Environment Variables

# JWT Security
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key_in_production
JWT_ISSUER=EduFlowApi
JWT_AUDIENCE=EduFlowClient
JWT_EXPIRY_MINUTES=120

# Database Configuration (PostgreSQL in Production)
POSTGRES_DB=EduFlowDb
POSTGRES_USER=eduflow_user
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_PORT=5432
CONNECTION_STRING=Host=127.0.0.1;Port=5432;Database=EduFlowDb;Username=eduflow_user;Password=replace_with_strong_database_password

# Initial Seed Credentials (changed immediately in production)
SEED_ADMIN_PASSWORD=replace_with_strong_initial_admin_password

# CORS Settings (comma-separated list of allowed frontend domains)
CORS_ALLOWED_ORIGINS=https://app.eduflow.uz,https://admin.eduflow.uz

# Integrations (Optional)
TELEGRAM_BOT_TOKEN=
SMS_API_KEY=
